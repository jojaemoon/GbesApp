        /*border-bottom: solid #aaaaaa 1px; */
        /* padding-bottom: 10px;
                    padding-left: 10px; */
        /* position: relative; */
        background: none;
        z-index: 5;
    }

        input::placeholder {
            color: #aaaaaa;
            font-size: 12px;
        }

