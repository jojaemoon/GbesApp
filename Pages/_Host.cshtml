                function openModal(modalname) {
            if (!modalname) {
                $(".modal-custom").fadeIn(300);
                return;
            }

            if (modalname.startsWith(".")) {
                $(modalname).fadeIn(300);
            } else {
                $("." + modalname).fadeIn(300);
            }
        }

        // 팝업 닫기
        function closeModal(modalname) {
            if (!modalname) {
                $(".modal-custom").fadeOut(300);
                return;
            }

            if (modalname.startsWith(".")) {
                $(modalname).fadeOut(300);
            } else {
                $("." + modalname).fadeOut(300);
            }
        }

