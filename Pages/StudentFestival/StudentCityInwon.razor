@page "/StudentCityInwon"

<div class="menu_title subimg3 no-print">
    <h3>경상북도학생체육대회</h3>
</div>
<div class="sub_menu no-print">
    <ul>
        @if (!string.IsNullOrEmpty(memberName))
        {
            <li><a href="/MemberFirst">로그인정보</a></li>
        }
        <li><a href="/StudentIntro">대회일정</a></li>
        @if (!string.IsNullOrEmpty(memberName))
        {
            <li><a href="/StudentPartyEntry">참가신청</a></li>
        }
        <li class="on"><a href="/StudentCityInwon">참가현황</a></li>
        <li><a href="/StudentGameResult">경기결과</a></li>
        <li><a href="/StudentJonghapResult">육상성적</a></li>
        @if (memberPart == "경기단체" || memberPart == "교육지원청" || memberPart == "경북교육청" || memberPart == "관리자")
        {
            <li><a href="/StudentGameOfficials">시간할애</a></li>
        }
        @if (memberPart == "경북교육청" || memberPart == "관리자")
        {
            <li><a href="/StudentGamePartyEnd">마감처리</a></li>
        }
    </ul>
</div>

<div id="search">
    <div class="data_list">
        @* <div>
            <h4>
                @memberName 경상북도 학생체육대회 시군별 참가선수 현황
                <span class="goBtn">
                    <a class="btn btn-success" href="/StudentPartyGameInwon">종목별 참가현황 가기 >></a>
                </span>
            </h4>
        </div> *@
        <div class="wrap">
            <div class="filter">
                <h2 id="partyname" style="display: none;"><span style="font-weight: bold;">@partyName</span></h2>
                <h2><span style="font-weight: bold;">@memberName</span> 시군별 참가선수 현황</h2>
                <div class="line"></div>
                <button type="button" class="btn btn-danger d-flex align-items-center no-print" @onclick="GoToGameInwon">
                    <div>종목별현황보기</div>
                    <div>>></div>
                </button>
                <button type="button" id="addPlayer" class="plus no-print" @onclick="PrintPage">
                    <div>인쇄</div>
                    <div><img src="../imgs/sub/printer.png"></div>
                </button>
                <button type="button" id="excelDown" class="excel no-print" @onclick="DownLoadExcel">엑셀다운받기<img src="../imgs/sub/excel_icon.png"></button>
            </div>
        </div>
        <div>
            <table class="table table--block" cellspacing="0" cellpadding="0">
                <thead>
                    <tr>
                        <th rowspan="2">순</th>
                        <th rowspan="2">시군</th>
                        <th colspan="3">초등부</th>
                        <th colspan="3">중학부</th>
                        <th colspan="3">고등부</th>
                        <th rowspan="2">선수계</th>
                        <th rowspan="2">임원수</th>
                        <th rowspan="2">합계</th>
                    </tr>
                    <tr>
                        <td>남</td>
                        <td>여</td>
                        <td>계</td>
                        <th>남</th>
                        <th>여</th>
                        <th>계</th>
                        <td>남</td>
                        <td>여</td>
                        <td>계</td>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in listInwon)
                    {
                        <tr>
                            <td>@item.no</td>
                            <td>@item.cname</td>
                            <td>@(item.primaryMan == 0 ? "" : item.primaryMan)</td>
                            <td>@(item.primaryWoman == 0 ? "" : item.primaryWoman)</td>
                            <td>@(item.primaryHap == 0 ? "" : item.primaryHap)</td>
                            <td>@(item.middleMan == 0 ? "" : item.middleMan)</td>
                            <td>@(item.middleWoman == 0 ? "" : item.middleWoman)</td>
                            <td>@(item.middleHap == 0 ? "" : item.middleHap)</td>
                            <td>@(item.highMan == 0 ? "" : item.highMan)</td>
                            <td>@(item.highWoman == 0 ? "" : item.highWoman)</td>
                            <td>@(item.highHap == 0 ? "" : item.highHap)</td>
                            <td>@(item.playerHap == 0 ? "" : item.playerHap)</td>
                            <td>@(item.officer == 0 ? "" : item.officer)</td>
                            <td>@(item.totalHap == 0 ? "" : item.totalHap)</td>
                        </tr>
                    }
                    <tr class="trFooter">
                        <td colspan="2">계</td>
                        <td>@(listInwon.Sum(it => it.primaryMan) == 0 ? "" : listInwon.Sum(it => it.primaryMan))</td>
                        <td>@(listInwon.Sum(it => it.primaryWoman) == 0 ? "" : listInwon.Sum(it => it.primaryWoman))</td>
                        <td>@(listInwon.Sum(it => it.primaryHap) == 0 ? "" : listInwon.Sum(it => it.primaryHap))</td>
                        <td>@(listInwon.Sum(it => it.middleMan) == 0 ? "" : listInwon.Sum(it => it.middleMan))</td>
                        <td>@(listInwon.Sum(it => it.middleWoman) == 0 ? "" : listInwon.Sum(it => it.middleWoman))</td>
                        <td>@(listInwon.Sum(it => it.middleHap) == 0 ? "" : listInwon.Sum(it => it.middleHap))</td>
                        <td>@(listInwon.Sum(it => it.highMan) == 0 ? "" : listInwon.Sum(it => it.highMan))</td>
                        <td>@(listInwon.Sum(it => it.highWoman) == 0 ? "" : listInwon.Sum(it => it.highWoman))</td>
                        <td>@(listInwon.Sum(it => it.highHap) == 0 ? "" : listInwon.Sum(it => it.highHap))</td>
                        <td>@(listInwon.Sum(it => it.playerHap) == 0 ? "" : listInwon.Sum(it => it.playerHap))</td>
                        <td>@(listInwon.Sum(it => it.officer) == 0 ? "" : listInwon.Sum(it => it.officer))</td>
                        <td>@(listInwon.Sum(it => it.totalHap) == 0 ? "" : listInwon.Sum(it => it.totalHap))</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .menu_title {
        text-align: center;
        color: #fff;
        background-color: #0075bf;
        width: 100%;
        height: 250px;
        margin-top: 100px;
    }

        .menu_title h3 {
            line-height: 250px;
        }

    .sub_menu {
        height: 50px;
        line-height: 50px;
        border-bottom: 1px solid #b8b8b8;
    }

        .sub_menu ul {
            display: flex;
            justify-content: center;
            gap: 30px;
            width: 95%;
            max-width: 1240px;
            margin: 0 auto;
        }

            .sub_menu ul li {
                line-height: 50px;
            }

        .sub_menu .on {
            color: #0075bf;
            border-bottom: 2px solid #0075bf;
        }

        .sub_menu ul li:hover {
            color: #0075bf;
            border-bottom: 2px solid #0075bf;
        }

    #search .wrap {
        width: 95%;
        max-width: 1240px;
        margin: 50px auto;
        text-align: center;
    }

    .filter {
        display: flex;
        background-color: #f2f2f2;
        border-radius: 10px;
        width: 100%;
        padding: 20px 50px;
        gap: 10px;
        margin-top: 30px;
    }

        .filter select {
            border-radius: 50px;
            background-color: #fff;
            flex: 1;
            height: 50px;
            padding: 10px;
            background-image: url(../imgs/sub/select_arrow.png);
            background-position: right 24px center;
            background-repeat: no-repeat;
        }

        .filter button {
            border-radius: 5px;
            width: 180px;
            font-size: 16px;
            height: 50px;
            padding: 0 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .filter .goBtn {
            background-color: deeppink;
            color: #fff;
        }

        .filter .plus {
            background-color: #0075bf;
            color: #fff;
        }

        .filter .excel {
            background-color: #fff;
            color: #111;
        }

        .filter .line {
            border-left: 1px solid #9b9b9b;
        }

    .modal_list select {
        border-radius: 50px;
        background-color: #fff;
        flex: 1;
        width: 200px;
        height: 40px;
        padding: 10px;
        background-image: url(../imgs/sub/select_arrow.png);
        background-position: right 24px center;
        background-repeat: no-repeat;
    }

    @@media screen and (max-width: 900px) {
        .filter {
            display: flex;
            flex-direction: column;
        }

            .filter button {
                width: 100%;
            }
    }

    .data_list {
        margin: 50px auto;
        width: 95%;
    }

    .delet_area {
        width: 100%;
        text-align: right;
        display: flex;
        justify-content: flex-end;
        margin-bottom: 30px;
    }

    .delet {
        border-radius: 5px;
        border: 1px solid #bbbbbb;
        width: 120px;
        font-size: 16px;
        height: 50px;
        padding: 0 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #111;
    }

    .delet_icon {
        border-radius: 50px;
        height: 18px;
        width: 18px;
        border: 2px solid #dc0000;
        color: #dc0000;
        line-height: 15px;
        margin: 0 auto;
    }

    .table {
        table-layout: fixed;
        width: 100%;
        text-align: center;
    }

        .table tr {
        }

        .table th {
            background: #eef4ff;
            padding: 20px 10px;
            word-break: break-all
        }

        .table td {
            padding: 10px 10px;
            border-bottom: 1px solid #ccc;
            word-break: break-all;
            height: 50px;
        }

            .table td a {
                text-decoration: underline;
            }

                .table td a:hover {
                    color: #0075bf
                }

    .trFooter {
        background-color: lightgoldenrodyellow;
    }

    @@media screen and (max-width:768px) {
        /*block*/
        .table--block thead {
            display: none;
        }

        .table--block tr {
            display: block;
            margin-bottom: 10px;
            border-top: 1px solid #ccc;
            border-bottom: 1px solid #ccc;
        }

        .table--block th,
        .table--block td {
            display: block;
            position: relative;
            padding: 10px 0;
            padding-left: 50%;
            border-width: 0 0 1px 0;
        }

            .table--block td:before {
                display: block;
                position: absolute;
                left: 0;
                top: 0;
                width: 50%;
                padding: 10px 0;
                background: #eef4ff;
            }

            .table--block td:nth-child(1):before {
                content: '선택';
            }

            .table--block td:nth-child(2):before {
                content: '순번';
            }

            .table--block td:nth-child(3):before {
                content: '종목';
            }

            .table--block td:nth-child(4):before {
                content: '종별';
            }

            .table--block td:nth-child(5):before {
                content: '이름';
            }

            .table--block td:nth-child(6):before {
                content: '생년월일';
            }

            .table--block td:nth-child(7):before {
                content: '소속';
            }

            .table--block td:nth-child(8):before {
                content: '학년';
            }

            .table--block td:nth-child(9):before {
                content: '세부1';
            }

            .table--block td:nth-child(10):before {
                content: '비고';
            }

            .table--block td:nth-child(11):before {
                content: '삭제';
            }
    }

    /* 모달 스타일 */
    /*모달버튼*/
    .modal-content {
        width: 100%;
        top: 0;
    }

    .modal-custom {
        position: fixed;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.35);
        z-index: 9999;
        cursor: pointer;
        display: none;
        text-align: center;
    }

    .modal-window {
        position: absolute;
        top: 20%;
        left: 50%;
        transform: translate(-50%, -20%);
        z-index: 9999;
        width: 95%;
        max-width: 700px;
    }

    .close-modal {
        text-align: center;
        font-size: 28px;
        font-weight: bold;
    }

        .close-modal img {
            margin-bottom: 20px
        }

        .close-modal:hover,
        .close-modal:focus {
            color: #000;
            text-decoration: none;
            cursor: pointer;
        }

    .close-area {
        cursor: pointer;
        text-align: center;
        margin-bottom: 20px;
    }

    .modal-wrap {
        margin-top: 20px;
        font-size: 18px;
        background: rgba(255, 255, 255, 100);
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        border-radius: 10px;
        max-width: 700px;
        width: 95%;
        padding: 50px 30px;
        margin: 0 auto;
        max-height: calc(100vh - 100px);
        overflow: hidden;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }

    .modal_list {
        width: 100%;
        display: flex;
        font-size: 20px;
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: space-around;
        text-align: left;
        gap: 10px;
    }


        .modal_list .type {
            width: 45%;
            padding-bottom: 15px;
        }

        .modal_list .full {
            width: 100%;
        }


        .modal_list .type .title {
            font-weight: 600;
        }

        .modal_list .type .data {
            margin-top: 10px;
            height: 40px;
            line-height: 40px;
            font-size: 16px;
            font-weight: 400;
            /* border-bottom: 1px solid #333; */
        }

    .btn_wrap {
        display: flex;
        gap: 10px;
        justify-content: center;
    }

        .btn_wrap button {
            border-radius: 5px;
            width: 180px;
            color: #fff;
            width: 40%;
            height: 50px;
        }

    .cancel {
        background-color: #666;
        color: #fff
    }

    .edit {
        background-color: #0075bf;
        color: #fff
    }

    .delete {
        background-color: red;
        color: #fff
    }
</style>

<style>
    .showCSS {
        display: inline;
    }

    .hideCss {
        display: none;
    }

    input {
        font-size: 18px;
        color: #222222;
        width: 250px;
        border: 1px solid black;
        padding: 3px;
        height: 40px;
        /*border-bottom: solid #aaaaaa 1px; */
        /* padding-bottom: 10px;
                                                                            padding-left: 10px; */
        /* position: relative; */
        background: none;
        z-index: 5;
    }

        input::placeholder {
            color: #aaaaaa;
        }

        input:focus {
            outline: none;
        }

        input:focus, .modal_list input:valid {
            font-size: 16px;
            bottom: 40px;
            color: #666;
            font-weight: bold;
        }

        input:focus, .modal_list input:valid {
            width: 100%;
        }

    .btn-danger {
        background-color: #d63031; /* 원하는 붉은 계열 */
        border-color: #c0392b;
    }

        .btn-danger:hover {
            background-color: #e74c3c;
        }

    @@media print {
        /* 페이지 여백도 최소화 */
        @@page {
            margin: 5mm;
        }

        table.table {
            transform: scale(0.7);
            transform-origin: top left;
            width: 100%;
            display: block; /* 필요 시 블록 디스플레이로 변경 */
        }

        table.table, table.table--block {
            table-layout: fixed !important;
        }


        table.table th,
        table.table td {
            all: unset;
            display: table-cell;
            padding: 4px 2px;
            border: 1px solid #000;
            font-size: 11px;
            line-height: 1.1;
            text-align: center;
        }

        /* 테이블 기본값 초기화 */
        table.table, table.table--block {
            border-collapse: collapse !important;
            border-spacing: 0 !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            table-layout: fixed !important;
        }
            /* Bootstrap padding 강제 덮어쓰기 */
            table.table th,
            table.table td {
                padding: 4px 2px !important; /* 인쇄용 최소 여백 */
                margin: 0 !important;
                border: 1px solid #000 !important;
                font-size: 11px !important;
                line-height: 1.1 !important;
                background: #fff !important;
            }
            /* 헤더 강조 */
            table.table th {
                font-weight: 600 !important;
                background: #f2f2f2 !important;
            }
              
            table.table td {
                width: 80px !important;
            }
            /*
            table.table td:not(:nth-child(1)):not(:nth-child(2)) {
                width: 80px !important; 
            }

            table.table td:nth-child(1) {
                width: 50px !important;
            }

            table.table td:nth-child(2) {
                width: 120px !important;
            }
                */

        /* 인쇄 시 헤더 고정 */
        thead {
            display: table-header-group !important;
        }

        tbody {
            display: table-row-group !important;
        }
        /* 행이 페이지에서 잘리지 않게 */
        tr, th, td {
            page-break-inside: avoid !important;
            break-inside: avoid !important;
        }
        /* 화면의 불필요한 영역 제거 */
        .no-print {
            display: none !important;
        }

        #partyname {
            display: block !important;
        }
    }
</style>


