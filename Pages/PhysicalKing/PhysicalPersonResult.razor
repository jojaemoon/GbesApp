@page "/PhysicalPersonResult"

<div class="menu_title subimg3">
    <h3>경상북도 체력인증제</h3>
</div>
<div class="sub_menu">
    <ul>
        <li><a href="/MemberFirst">로그인정보</a></li>
        <li><a href="/PhysicalIntro">대회요강</a></li>
        <li><a href="/PhysicalPartyEntry">참가신청</a></li>
        <li><a href="/PhysicalPartyInwon">참가현황</a></li>
        <li class="on"><a href="/PhysicalResult">측정결과</a></li>
    </ul>
</div>

<div id="search">
    <div class="wrap">
        <h2>2025 경상북도 체력인증제 자기점수 확인</h2>
        <div class="filter">
            <div class="serach_icon"><img src="../imgs/sub/search_icon.png"></div>
            아이디(번호)
            <input type="text" class="form-control" @bind="loginID">
            비밀번호
            <input type="text" class="form-control" @bind="passWord">
            <button class="btn btn-success" @onclick="ConfirmMember">확인</button>
            @if (memberPass)
            {
                <span style="margin-left:30px;">비밀번호변경</span>
                <input type="text" class="form-control" @bind="newPassword">
                <button class="btn btn-danger" @onclick="ChangePass">저장</button>
            }
        </div>
    </div>

    @if (memberPass)
    {
        <div class="data_list">
            <div>
                <table class="table table--block" cellspacing="0" cellpadding="0">
                    <thead>
                        <tr>
                            <th class="tdSubject" colspan="3">
                                2025 경북 학교체육 한마당
                                <br /><br />
                                체력인증제
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="3">
                                <span id="tRank">@(memberRecord.rank)위</span>
                                <span id="tJumsu">@(memberRecord.jumsuHap)점</span>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="3">
                                <span id="name">@memberRecord.name</span>
                                <span id="sName">
                                    @memberRecord.sName
                                </span>
                                <span id="schoolName">
                                    @memberRecord.schoolName
                                </span>
                                <span id="schoolYear">
                                    @(memberRecord.schoolYear)학년
                                </span>
                            </td>
                        </tr>
                        <tr id="title">
                            <td>종목명</td>
                            <td>기록</td>
                            <td>점수</td>
                            @* <td>순위</td> *@
                        </tr>
                        <tr id="trRecord">
                            <td>악력</td>
                            <td>@memberRecord.gripRecord<span>kg</span></td>
                            <td>@memberRecord.gripJumsu</td>
                            @* <td>@memberRecord.gripRank</td> *@
                        </tr>
                        <tr id="trRecord">
                            <td>제자리멀리뛰기</td>
                            <td>@memberRecord.jumpRecord<span>cm</span></td>
                            <td>@memberRecord.jumpJumsu</td>
                            @* <td>@memberRecord.jumpRank</td> *@
                        </tr>
                        <tr id="trRecord">
                            <td>윗몸앞으로굽히기</td>
                            <td>@memberRecord.bendRecord<span>cm</span></td>
                            <td>@memberRecord.bendJumsu</td>
                            @* <td>@memberRecord.bendRank</td> *@
                        </tr>
                        <tr id="trRecord">
                            <td>50m 달리기</td>
                            <td>@TimeToHangul(memberRecord.run50mRecord)</td>
                            <td>@memberRecord.run50mJumsu</td>
                            @* <td>@memberRecord.run50mRank</td> *@
                        </tr>
                        <tr id="trRecord">
                            <td>순환운동</td>
                            <td>@TimeToHangul(memberRecord.movementRecord)</td>
                            <td>@memberRecord.movementJumsu</td>
                            @* <td>@memberRecord.movementRank</td> *@
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td class="tdSubject" colspan="3">
                                인증일 2025. 11. 2.<br /><br />
                                경상북도교육감
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

        </div>
    }

</div>

<style>

    @@media screen and (max-width:768px) {
        .table--block td {
            min-width: 50px;
        }
    }

</style>

