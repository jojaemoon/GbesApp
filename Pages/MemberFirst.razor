@page "/MemberFirst"

<div class="menu_title">
    <h3>회 원 정 보</h3>
</div>

<div class="sub_menu">
    <ul>
        <li><a href="/BoyIntro">경북소년체육대회</a></li>
        <li><a href="/YearTrackIntro" style="color: red;">학년별육상경기대회</a></li>
        <li><a href="/StudentIntro">경북학생체육대회</a></li>
        <li><a href="/MarthonIntro">구간마라톤대회</a></li>
        <li><a href="/PhysicalIntro">체력왕선발대회</a></li>
    </ul>
</div>

<div id="search">
    <div class="wrap">
        <div style="text-align: left;">
            <div style="margin: 20px;">
                <h3>회원 정보</h3>
            </div>
            <div style="margin: 20px;">
                <span class="ti">학교명 (단체명)</span>
                <input type="text" class="inputTxt" @bind="model.memberName" disabled />
            </div>
            <div style="margin: 20px;">
                <span class="ti">비밀번호</span>
                <input type="text" class="inputTxt" @bind="model.logPW" />
            </div>
            <div style="margin: 20px;">
                <span class="ti">담당자 이름</span>
                <input type="text" class="inputTxt" @bind="model.name" placeholder="필수입력" />
                <span style="margin-left: 100px;">※ 학교는 지도교사 이름 입력</span>
            </div>
            <div style="margin: 20px;">
                <span class="ti">전화번호</span>
                <input type="text" class="inputTxt" @bind="model.phone" />
            </div>
            <div style="margin: 20px;">
                <button class="btnPrimary" @onclick="Save_Click" style="width: 100px;">저 장</button>
            </div>
        </div>

        @if (memberName == "경북교육청" || memberName == "관리자")
        {
            @* <div style="text-align: left;">
                <div style="margin: 20px;">
                    <h3>2025 경상북도교육감배 초·중학년별 육상경기대회 사용여부 </h3>
                </div>
                <div class="inline-container">
                    <input type="checkbox" @bind="isUse"  @onchange="OnUseChanged" id="chk1" />
                    <label for="chk1" class="checkbox-label">사용</label>
                    <input type="checkbox" @bind="isEnd" @onchange="OnEndChanged"  id="chk2" style="margin-left: 24px;" />
                    <label for="chk2" class="checkbox-label">마감</label>
                    <button class="save-btn" @onclick="Save">저장</button>
                </div>

                @if (saveResult != null)
                {
                    <div class="result-text">@saveResult</div>
                }
            </div> *@
        }

        <div style="color: red;">
            <h3>참가신청 목록에서 "등록완료"를 클릭하면 등록한 확인서가 다운로드 됩니다. </h3>
        </div>


        @if (memberName == "경북교육청" || memberName == "관리자")
        {
            <div class="filter row">
                <div class="serach_icon"><img src="../imgs/sub/search_icon.png"></div>
                @* <select @onchange="SelectCity">
                    <option>시/군</option>
                    @foreach (var item in cNameList)
                    {
                        <option>@item</option>
                    }
                </select>
                <select @onchange="SelectSchoolName">
                    <option>학교선택</option>
                    @foreach (var item in schoolNameList)
                    {
                        <option>@item</option>
                    }
                </select> *@
                <input type="text" @bind="searchText" placeholder="단체명 2글자 이상">
                <button @onclick="FindMembger">찾기</button>
            </div>
        }
    </div>
    @if (memberName == "경북교육청" || memberName == "관리자")
    {
        <div class="data_list">
            <div>
                <table class="table table--block" cellspacing="0" cellpadding="0">
                    <thead>
                        <tr>
                            @* <th style="width:7%">선택</th> *@
                            <th>순</th>
                            <th>구분</th>
                            <th>시군</th>
                            <th style="width: 15%;">단체명(학교명)</th>
                            <th style="width: 15%;">로그아이디</th>
                            <th>비밀번호</th>
                            <th>담당자명</th>
                            <th>연락처</th>
                            <th>비고</th>
                            <th style="width:7%"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isEdit)
                        {
                            <tr>
                                <td></td>
                                <td><input type="text" @bind="editModel.division"></input></td>
                                <td><input type="text" @bind="editModel.city"></input></td>
                                <td><input type="text" @bind="editModel.memberName" style="width: 180px;"></input></td>
                                <td><input type="text" @bind="editModel.logID" style="width: 180px;"></input></td>
                                <td><input type="text" @bind="editModel.logPW"></input></td>
                                <td><input type="text" @bind="editModel.phone"></input></td>
                                <td><input type="text" @bind="editModel.etc"></input></td>
                                <td>
                                    <button style="background-color: blue; color: white;" @onclick="(()=>MemberEditSave(editModel))">저장</button>&nbsp;
                                    <button style="background-color: lightgray;" @onclick="Cancel">취소</button>
                                </td>
                            </tr>
                        }
                        @{
                            int i = 0;
                        }

                        @foreach (var item in listMember)
                        {
                            i++;
                            <tr>
                                <td>@i</td>
                                <td>@item.division</td>
                                <td>@item.city</td>
                                <td>@item.memberName</td>
                                <td>@item.logID</td>
                                <td>@item.logPW</td>
                                <td>@item.phone</td>
                                <td>@item.etc</td>
                                <td>
                                    <button class="modal-custom-button" @onclick="(()=>MemberEdit(item))">수정</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    }

    
</div>

<style>
    .btnPrimary {
        background-color: #0075bf;
        border-radius: 5px;
        text-align: center;
        padding: 7px 5px;
        color: #fff;
        font-size: 16px;
        font-weight: 400;
        display: inline-block;
    }
</style>

<style>
    .menu_title {
        text-align: center;
        color: #fff;
        background-color: #0075bf;
        width: 100%;
        height: 250px;
        margin-top: 100px;
    }

        .menu_title h3 {
            line-height: 250px;
        }

    .sub_menu {
        height: 50px;
        line-height: 50px;
        border-bottom: 1px solid #b8b8b8;
    }

        .sub_menu ul {
            display: flex;
            justify-content: center;
            gap: 30px;
            width: 95%;
            max-width: 1240px;
            margin: 0 auto;
        }

            .sub_menu ul li {
                line-height: 50px;
            }

        .sub_menu .on {
            color: #0075bf;
            border-bottom: 2px solid #0075bf;
        }

        .sub_menu ul li:hover {
            color: #0075bf;
            border-bottom: 2px solid #0075bf;
        }

    #search .wrap {
        width: 95%;
        max-width: 1240px;
        margin: 50px auto;
        text-align: center;
    }

    .filter {
        display: flex;
        background-color: #f2f2f2;
        border-radius: 10px;
        width: 100%;
        padding: 20px 50px;
        gap: 10px;
        margin-top: 30px;
    }

        .filter select {
            border-radius: 50px;
            background-color: #fff;
            flex: 1;
            height: 50px;
            padding: 10px;
            background-image: url(../imgs/sub/select_arrow.png);
            background-position: right 24px center;
            background-repeat: no-repeat;
        }

        .filter button {
            border-radius: 5px;
            width: 180px;
            font-size: 16px;
            height: 50px;
            padding: 0 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .filter .plus {
            background-color: #0075bf;
            color: #fff;
        }

        .filter .excel {
            background-color: #fff;
            color: #111;
        }

        .filter .line {
            border-left: 1px solid #9b9b9b;
        }

    @@media screen and (max-width: 900px) {
        .filter {
            display: flex;
            flex-direction: column;
        }

            .filter button {
                width: 100%;
            }
    }

    .data_list {
        margin: 50px auto;
        width: 95%;
    }

    .delet_area {
        width: 100%;
        text-align: right;
        display: flex;
        justify-content: flex-end;
        margin-bottom: 30px;
    }

    .delet {
        border-radius: 5px;
        border: 1px solid #bbbbbb;
        width: 120px;
        font-size: 16px;
        height: 50px;
        padding: 0 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #111;
    }

    .delet_icon {
        border-radius: 50px;
        height: 18px;
        width: 18px;
        border: 2px solid #dc0000;
        color: #dc0000;
        line-height: 15px;
        margin: 0 auto;
    }

    .table {
        table-layout: fixed;
        width: 100%;
        text-align: center;
    }

        .table tr {
        }

        .table th {
            background: #eef4ff;
            padding: 20px 10px;
            word-break: break-all
        }

        .table td {
            padding: 10px 10px;
            border-bottom: 1px solid #ccc;
            word-break: break-all
        }

            .table td a {
                text-decoration: underline;
            }

                .table td a:hover {
                    color: #0075bf
                }

    @@media screen and (max-width:768px) {
        /*block*/
        .table--block thead {
            display: none;
        }

        .table--block tr {
            display: block;
            margin-bottom: 10px;
            border-top: 1px solid #ccc;
            border-bottom: 1px solid #ccc;
        }

        .table--block th,
        .table--block td {
            display: block;
            position: relative;
            padding: 10px 0;
            padding-left: 50%;
            border-width: 0 0 1px 0;
        }

            .table--block td:before {
                display: block;
                position: absolute;
                left: 0;
                top: 0;
                width: 50%;
                padding: 10px 0;
                background: #eef4ff;
            }

            .table--block td:nth-child(1):before {
                content: '선택';
            }

            .table--block td:nth-child(2):before {
                content: '순번';
            }

            .table--block td:nth-child(3):before {
                content: '종목';
            }

            .table--block td:nth-child(4):before {
                content: '종별';
            }

            .table--block td:nth-child(5):before {
                content: '이름';
            }

            .table--block td:nth-child(6):before {
                content: '생년월일';
            }

            .table--block td:nth-child(7):before {
                content: '소속';
            }

            .table--block td:nth-child(8):before {
                content: '학년';
            }

            .table--block td:nth-child(9):before {
                content: '세부1';
            }

            .table--block td:nth-child(10):before {
                content: '비고';
            }

            .table--block td:nth-child(11):before {
                content: '삭제';
            }
    }

    /* 모달 스타일 */
    /*모달버튼*/
    .modal-content {
        width: 100%;
        top: 0;
    }

    .modal-custom {
        position: fixed;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.35);
        z-index: 9999;
        cursor: pointer;
        display: none;
        text-align: center;
    }

    .modal-window {
        position: absolute;
        top: 20%;
        left: 50%;
        transform: translate(-50%, -20%);
        z-index: 9999;
        width: 95%;
        max-width: 700px;
    }

    .close-modal {
        text-align: center;
        font-size: 28px;
        font-weight: bold;
    }

        .close-modal img {
            margin-bottom: 20px
        }

        .close-modal:hover,
        .close-modal:focus {
            color: #000;
            text-decoration: none;
            cursor: pointer;
        }

    .close-area {
        cursor: pointer;
        text-align: center;
        margin-bottom: 20px;
    }

    .modal-wrap {
        margin-top: 20px;
        font-size: 18px;
        background: rgba(255, 255, 255, 100);
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        border-radius: 10px;
        max-width: 700px;
        width: 95%;
        padding: 50px 30px;
        margin: 0 auto;
        max-height: calc(100vh - 100px);
        overflow: hidden;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }

    .modal_list {
        width: 100%;
        display: flex;
        font-size: 20px;
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: space-around;
        text-align: left;
        gap: 10px;
    }


        .modal_list .type {
            width: 45%;
            padding-bottom: 15px;
        }

        .modal_list .full {
            width: 100%;
        }


        .modal_list .type .title {
            font-weight: 600;
        }

        .modal_list .type .data {
            margin-top: 10px;
            height: 40px;
            line-height: 40px;
            font-size: 16px;
            font-weight: 400;
            border-bottom: 1px solid #333;
        }

    .btn_wrap {
        display: flex;
        gap: 10px;
        justify-content: center;
    }

        .btn_wrap button {
            border-radius: 5px;
            width: 180px;
            color: #fff;
            width: 40%;
            height: 50px;
        }

    .cancel {
        background-color: #666;
        color: #fff
    }

    .edit {
        background-color: #0075bf;
        color: #fff
    }

    span.ti {
        width: 100px;
    }

    .inputTxt {
        width: 300px;
        border: 1px solid gray;
    }

    input {
        font-size: 16px;
        color: #222222;
        width: 100px;
        border: 1px solid black;
        padding: 2px;
        height: 40px;
        background: none;
    }

</style>

<style>

    /* Full-width input fields */
    input[type=text], input[type=password] {
        width: 100%;
        padding: 12px 10px;
        margin: 8px 0 20px 0;
        display: inline-block;
        border: 1px solid #ccc;
        box-sizing: border-box;
        border-radius: 5px;
    }

    .logBtn {
        display: block;
        background-color: #0075bf;
        color: white;
        height: 44px;
        border-radius: 5px;
        margin-top: 15px;
        border: none;
        cursor: pointer;
        width: 100%;
        text-align: center;
        line-height: 44px;
    }

    /* Set a style for all buttons */
    button {
        background-color: #4CAF50;
        color: white;
        padding: 14px 20px;
        margin: 8px 0;
        border: none;
        cursor: pointer;
        width: 100%;
    }

        button:hover, btn:hover, a:hover {
            opacity: 0.8;
        }

    /* Extra styles for the cancel button */
    .cancelbtn {
        width: auto;
        padding: 10px 18px;
        background-color: #f44336;
    }

    /* Center the image and position the close button */
    .imgcontainer {
        display: flex;
        text-align: center;
        margin: 0 auto 20px auto;
        position: relative;
        flex-direction: column;
        align-items: center;
    }

    img.avatar {
        width: 40%;
        border-radius: 50%;
    }

    .modal .container {
        padding: 16px;
    }

    span.psw {
        float: right;
        padding-top: 16px;
    }

    /* The Modal (background) */
    .modal {
        display: block; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 1; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
        padding-top: 60px;
    }

    /* Modal Content/Box */
    .modal-content {
        background-color: #fff;
        margin: 10% auto 15% auto;
        width: 90%;
        max-width: 400px;
        border-radius: 20px;
        padding: 20px;
    }

    .login_box {
        background-color: #fefefe;
    }

    /* The Close Button (x) */
    .close {
        /* position: absolute;
        right: 25px;
        top: 0;
        color: #000;
        font-size: 35px;
        font-weight: bold;*/
        padding-bottom: 20px
    }

    /* Add Zoom Animation */
    .animate {
        -webkit-animation: animatezoom 0.6s;
        animation: animatezoom 0.6s
    }

    @@-webkit-keyframes animatezoom {
        from {
            -webkit-transform: scale(0)
        }

        to {
            -webkit-transform: scale(1)
        }
    }

    @@keyframes animatezoom {
        from {
            transform: scale(0)
        }

        to {
            transform: scale(1)
        }
    }

    /* Change styles for span and cancel button on extra small screens */
    @@media (max-width: 500px) {
        .modal-content {
            margin: 20% auto 15% auto;
            padding: 20px 10px;
        }

        .modal .container {
            padding: 15px 5px;
        }
    }

    @@media screen and (max-width: 300px) {
        span.psw {
            display: block;
            float: none;
        }

        .cancelbtn {
            width: 100%;
        }
    }

    .inline-container {
        display: flex;
        align-items: center;
        gap: 16px;
        background: #f6f8fa;
        padding: 18px 28px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(100, 100, 100, 0.06);
        font-family: 'Noto Sans KR', 'Segoe UI', Arial, sans-serif;
        font-size: 1.1rem;
    }

    .checkbox-label {
        margin-right: 8px;
        margin-left: 4px;
    }

    .save-btn {
        margin-left: 32px;
        padding: 8px 24px;
        background: #2d72d9;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

        .save-btn:hover {
            background: #1b4e94;
        }

    .result-text {
        margin-top: 18px;
        font-size: 1rem;
        color: #333;
    }
</style>
