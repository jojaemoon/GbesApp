@layout EmptyLayout

@page "/YearTrackCityInwon_Print"

<body onload="setTimeout(function () { window.print(); }, 1000);
    window.onafterprint = function(){ window.close(); };" style="text-align: center;">
    <div id="search">
        <div class="data_list">
            <div>
                <h3>
                    @partyName

                    @* @memberName &nbsp;&nbsp;&nbsp; *@
                </h3>
            </div>
            <div>
                <table id="tblInwon" class="table table-striped table--block" cellspacing="0" cellpadding="0">
                    <colgroup>
                        <col style="width:3%" />
                        <col style="width:9%" />
                        <col style="width:5%" />
                        <col style="width:4%" />
                        <col style="width:5%" />
                        <col style="width:5%" />
                        <col style="width:5%" />
                        <col style="width:5%" />
                        <col style="width:5%" />
                        <col style="width:3%" />
                        <col style="width:3%" />
                        <col style="width:3%" />
                        <col style="width:3%" />
                        <col style="width:3%" />
                        <col style="width:3%" />
                        <col style="width:3%" />
                        <col style="width:3%" />
                        <col style="width:3%" />
                        <col style="width:3%" />
                        <col style="width:3%" />
                        <col style="width:3%" />
                        <col style="width:3%" />
                        <col style="width:3%" />
                        <col style="width:3%" />
                        <col style="width:3%" />
                        <col style="width:3%" />
                        <col style="width:3%" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th rowspan="2">순</th>
                            <th rowspan="2" class="name">소속</th>
                            <th rowspan="2" class="citysum">합계</th>
                            <th rowspan="2" class="hap">교사계</th>
                            <th rowspan="2" class="hap">선수계</th>
                            <th rowspan="2" class="hap">남자계</th>
                            <th rowspan="2" class="hap">여자계</th>
                            <th rowspan="2" class="hap">초등계</th>
                            <th rowspan="2" class="hap">중학계</th>
                            <th colspan="5">남자초등부</th>
                            <th colspan="5">여자초등부</th>
                            <th colspan="4">남자중학부</th>
                            <th colspan="4">여자중학부</th>
                        </tr>
                        <tr>
                            <th>남초3</th>
                            <th>남초4</th>
                            <th>남초5</th>
                            <th>남초6</th>
                            <th class="hap">계</th>
                            <th>여초3</th>
                            <th>여초4</th>
                            <th>여초5</th>
                            <th>여초6</th>
                            <th class="hap">계</th>
                            <th>남중1</th>
                            <th>남중2</th>
                            <th>남중3</th>
                            <th class="hap">계</th>
                            <th>여중1</th>
                            <th>여중2</th>
                            <th>여중3</th>
                            <th class="hap">계</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="trHeader">
                            <td colspan="2" class="name">합계</td>
                            <td class="citysum">@(listInwon.Sum(it => it.totalHap) == 0 ? "" : listInwon.Sum(it => it.totalHap))</td>
                            <td class="hap">@(listInwon.Sum(it => it.officer) == 0 ? "" : listInwon.Sum(it => it.officer))</td>
                            <td class="hap">@(listInwon.Sum(it => it.playerHap) == 0 ? "" : listInwon.Sum(it => it.playerHap))</td>
                            <td class="hap">@(listInwon.Sum(it => it.playerManHap) == 0 ? "" : listInwon.Sum(it => it.playerManHap))</td>
                            <td class="hap">@(listInwon.Sum(it => it.playerWomanHap) == 0 ? "" : listInwon.Sum(it => it.playerWomanHap))</td>
                            <td class="hap">@(listInwon.Sum(it => it.primaryHap) == 0 ? "" : listInwon.Sum(it => it.primaryHap))</td>
                            <td class="hap">@(listInwon.Sum(it => it.middleHap) == 0 ? "" : listInwon.Sum(it => it.middleHap))</td>

                            <td>@(listInwon.Sum(it => it.pMan_3) == 0 ? "" : listInwon.Sum(it => it.pMan_3))</td>
                            <td>@(listInwon.Sum(it => it.pMan_4) == 0 ? "" : listInwon.Sum(it => it.pMan_4))</td>
                            <td>@(listInwon.Sum(it => it.pMan_5) == 0 ? "" : listInwon.Sum(it => it.pMan_5))</td>
                            <td>@(listInwon.Sum(it => it.pMan_6) == 0 ? "" : listInwon.Sum(it => it.pMan_6))</td>
                            <td class="hap">@(listInwon.Sum(it => it.primaryManHap) == 0 ? "" : listInwon.Sum(it => it.primaryManHap))</td>

                            <td>@(listInwon.Sum(it => it.pWoman_3) == 0 ? "" : listInwon.Sum(it => it.pWoman_3))</td>
                            <td>@(listInwon.Sum(it => it.pWoman_4) == 0 ? "" : listInwon.Sum(it => it.pWoman_4))</td>
                            <td>@(listInwon.Sum(it => it.pWoman_5) == 0 ? "" : listInwon.Sum(it => it.pWoman_5))</td>
                            <td>@(listInwon.Sum(it => it.pWoman_6) == 0 ? "" : listInwon.Sum(it => it.pWoman_6))</td>
                            <td class="hap">@(listInwon.Sum(it => it.primaryWomanHap) == 0 ? "" : listInwon.Sum(it => it.primaryWomanHap))</td>

                            <td>@(listInwon.Sum(it => it.mMan_1) == 0 ? "" : listInwon.Sum(it => it.mMan_1))</td>
                            <td>@(listInwon.Sum(it => it.mMan_2) == 0 ? "" : listInwon.Sum(it => it.mMan_2))</td>
                            <td>@(listInwon.Sum(it => it.mMan_3) == 0 ? "" : listInwon.Sum(it => it.mMan_3))</td>
                            <td class="hap">@(listInwon.Sum(it => it.middleManHap) == 0 ? "" : listInwon.Sum(it => it.middleManHap))</td>

                            <td>@(listInwon.Sum(it => it.mWoman_1) == 0 ? "" : listInwon.Sum(it => it.mWoman_1))</td>
                            <td>@(listInwon.Sum(it => it.mWoman_2) == 0 ? "" : listInwon.Sum(it => it.mWoman_2))</td>
                            <td>@(listInwon.Sum(it => it.mWoman_3) == 0 ? "" : listInwon.Sum(it => it.mWoman_3))</td>
                            <td class="hap">@(listInwon.Sum(it => it.middleWomanHap) == 0 ? "" : listInwon.Sum(it => it.middleWomanHap))</td>
                        </tr>
                        @foreach (var item in listInwon)
                        {
                            <tr>
                                <td>@item.no</td>
                                <td class="name" sthle="width: 10%;">@NameSplit(item.name)</td>
                                <td class="citysum hap">@(item.totalHap == 0 ? "" : item.totalHap)</td>
                                <td class="hap">@(item.officer == 0 ? "" : item.officer)</td>
                                <td class="hap">@(item.playerHap == 0 ? "" : item.playerHap)</td>
                                <td class="hap">@(item.playerManHap == 0 ? "" : item.playerManHap)</td>
                                <td class="hap">@(item.playerWomanHap == 0 ? "" : item.playerWomanHap)</td>
                                <td class="hap">@(item.primaryHap == 0 ? "" : item.primaryHap)</td>
                                <td class="hap">@(item.middleHap == 0 ? "" : item.middleHap)</td>

                                <td>@(item.pMan_3 == 0 ? "" : item.pMan_3)</td>
                                <td>@(item.pMan_4 == 0 ? "" : item.pMan_4)</td>
                                <td>@(item.pMan_5 == 0 ? "" : item.pMan_5)</td>
                                <td>@(item.pMan_6 == 0 ? "" : item.pMan_6)</td>
                                <td class="hap">@(item.primaryManHap == 0 ? "" : item.primaryManHap)</td>
                                <td>@(item.pWoman_3 == 0 ? "" : item.pWoman_3)</td>
                                <td>@(item.pWoman_4 == 0 ? "" : item.pWoman_4)</td>
                                <td>@(item.pWoman_5 == 0 ? "" : item.pWoman_5)</td>
                                <td>@(item.pWoman_6 == 0 ? "" : item.pWoman_6)</td>
                                <td>@(item.primaryWomanHap == 0 ? "" : item.primaryWomanHap)</td>

                                <td>@(item.mMan_1 == 0 ? "" : item.mMan_1)</td>
                                <td>@(item.mMan_2 == 0 ? "" : item.mMan_2)</td>
                                <td>@(item.mMan_3 == 0 ? "" : item.mMan_3)</td>
                                <td class="hap">@(item.middleManHap == 0 ? "" : item.middleManHap)</td>
                                <td>@(item.mWoman_1 == 0 ? "" : item.mWoman_1)</td>
                                <td>@(item.mWoman_2 == 0 ? "" : item.mWoman_2)</td>
                                <td>@(item.mWoman_3 == 0 ? "" : item.mWoman_3)</td>
                                <td class="hap">@(item.middleWomanHap == 0 ? "" : item.middleWomanHap)</td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
            <div style="font-size: 1.7em;">@year 년 <span style="margin-left: 30px; margin-right: 30px;">@month 월</span> @day 일</div>
            <br />
            <div><span style="font-size: 1.7em; margin-right:50px;">@memberName</span> 직인생략</div>
        </div>
    </div>
</body>

