<style>
    .table {
        table-layout: fixed;
        width: 100%;
        text-align: center;
    }

        .table tr {
        }

        .table th {
            background: #eef4ff;
            padding: 20px 2px;
            word-break: break-all
        }

        .table td {
            padding: 2px 2px;
            border-bottom: 1px solid #ccc;
            word-break: break-all
        }

            .table td a {
                text-decoration: underline;
            }

                .table td a:hover {
                    color: #0075bf
                }

    .trFooter {
        background-color: lightgoldenrodyellow;
    }

    page {
        margin-top: 0;
    }

    #tblInwon td {
        border: 1px solid black;
        height: 20px;
        width: auto;
    }

    #tblInwon th {
        border: 1px solid black;
        height: 24px;
    }

    @@media print {
        /* size: 210mm 297mm; */ /*A4*/

        @@page {
            size: A4 landscape;
            margin: 0;
        }

        #topcontainer {
            display: none !important;
        }
    }
</style>
